---
import { ClientRouter } from 'astro:transitions'
import NavSearch from '../components/NavSearch'
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'Simpsonizado' } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Buscador de frases de Los Simpsons" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-10 bg-primary px-4 py-3 flex items-center gap-4 shadow-sm">
      <a href="/" class="font-heading text-2xl font-bold text-ink no-underline shrink-0">Simpsonizado</a>
      <NavSearch client:load />
    </header>
    <main class="flex-1">
      <slot />
    </main>
  </body>
</html>
