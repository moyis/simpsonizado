---
import Layout from '../../../layouts/Layout.astro'
import { createSearchService } from '../../../lib/search-factory'
import { framePath, framesInRange, formatTimestamp } from '../../../lib/format'

export const prerender = false

const { episode, frame: frameParam } = Astro.params
const startMs = parseInt(frameParam ?? '', 10)

if (!episode || isNaN(startMs)) {
  return Astro.redirect('/404')
}

const service = createSearchService()
const detail = await service.getFrameDetail(episode, startMs)

if (!detail) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const frames = framesInRange(detail.episodeId, detail.startMs, detail.endMs)

const imgPath = framePath(detail.episodeId, detail.startMs)
const timestamp = formatTimestamp(detail.startMs)
const episodeLabel = `Temporada ${detail.season}, Episodio ${detail.episode}`
const searchQuery = Astro.url.searchParams.get('q') ?? ''
const backHref = searchQuery ? `/?q=${encodeURIComponent(searchQuery)}` : '/'
---

<Layout title={`${detail.text} — Simpsonizado`}>
  <div class="mx-auto max-w-4xl px-4 py-4">
    <a href={backHref} class="inline-block text-ink-muted no-underline mb-4 hover:underline">&larr; Volver a buscar</a>

    <div class="rounded-2xl overflow-hidden shadow-2xl mb-4">
      <img
        id="main-frame"
        src={imgPath}
        alt={detail.text}
        class="w-full block max-h-[60vh] object-contain bg-black"
        transition:name={`frame-${detail.episodeId}-${detail.startMs}`}
      />
    </div>

    {frames.length > 1 && (
      <div class="relative mb-4">
        <button id="carousel-prev" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 text-white w-8 h-8 rounded-full flex items-center justify-center transition-colors" aria-label="Anterior">&lsaquo;</button>
        <div id="carousel" class="flex gap-2 overflow-x-auto scroll-smooth px-10 pb-2" style="scrollbar-width: thin;">
          {frames.map((src, i) => (
            <img
              src={src}
              alt={detail.text}
              class={`shrink-0 w-24 md:w-28 block aspect-video object-cover rounded-lg cursor-pointer hover:ring-2 hover:ring-primary transition-all ${i === 0 ? 'ring-2 ring-primary' : ''}`}
              data-frame-src={src}
            />
          ))}
        </div>
        <button id="carousel-next" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 text-white w-8 h-8 rounded-full flex items-center justify-center transition-colors" aria-label="Siguiente">&rsaquo;</button>
      </div>
    )}

    <div class="bg-white rounded-2xl px-8 py-6 shadow-md">
      <p class="font-heading text-2xl text-ink mb-4 leading-relaxed">"{detail.text}"</p>
      <div class="flex flex-wrap gap-4 text-ink-muted text-sm">
        <span class="bg-primary text-ink px-3 py-1 rounded-full font-semibold text-sm">{episodeLabel}</span>
        {detail.episodeTitle && <span>{detail.episodeTitle}</span>}
        <span>{timestamp}</span>
      </div>
    </div>
  </div>

  <script>
    function initCarousel() {
      const carousel = document.getElementById('carousel')
      const prev = document.getElementById('carousel-prev')
      const next = document.getElementById('carousel-next')
      if (!carousel) return

      const scrollAmount = 300

      prev?.addEventListener('click', () => {
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' })
      })
      next?.addEventListener('click', () => {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' })
      })

      document.querySelectorAll('[data-frame-src]').forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const src = (thumb as HTMLImageElement).dataset.frameSrc
          const main = document.getElementById('main-frame') as HTMLImageElement
          if (src && main) main.src = src

          document.querySelectorAll('[data-frame-src]').forEach((t) =>
            t.classList.remove('ring-2', 'ring-primary')
          )
          thumb.classList.add('ring-2', 'ring-primary')
        })
      })
    }

    initCarousel()
    document.addEventListener('astro:page-load', initCarousel)
  </script>
</Layout>
